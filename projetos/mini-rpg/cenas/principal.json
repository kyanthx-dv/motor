    "vars": {
      "vida": 3,
      "moedas": 0,
      "fim": "jogando"
    },
    "scripts": {
      "hud": {
        "fonte": "// Mini-RPG (gerado a mão; os scripts são JS comum).\nfunction atualizar(e, dt, ctx) {\n  e.Sprite.rotulo = '♥ ' + ctx.vars.ler('vida') + '   moedas ' + ctx.vars.ler('moedas') + '/3';\n  const st = e.Script.estado;\n  if (ctx.vars.ler('fim') === 'jogando') { st.fimT = null; return; }\n  if (st.fimT == null) st.fimT = ctx.engine.tempo;\n  // depois de 1 s, tocar na tela (ou Espaço/Enter) recomeça — no celular não existe F5\n  if (ctx.engine.tempo - st.fimT > 1 && (ctx.input.pointer.pressed || ctx.input.pressed.has('acao'))) ctx.engine.reiniciar();\n}\n"
      },
      "moeda": {
        "fonte": "// Mini-RPG (gerado a mão; os scripts são JS comum).\nconst eventos = {\n  gatilho(e, d, ctx) {\n    const o = ctx.scene.get(d.outro); if (!o || o.nome !== 'jogador') return;\n    ctx.vars.somar('moedas', 1); ctx.efeitos.particulas(ctx.scene, e.Transform.x, e.Transform.y, { n: 12, cor: '#ffd400' });\n    if (ctx.audio) ctx.audio.efeito('moeda'); ctx.scene.destroy(e.id);\n    if (ctx.vars.ler('moedas') >= 3) { ctx.vars.definir('fim', 'venceu'); ctx.efeitos.fade(ctx.scene, '#000000', 0, 0.75, 1); const a = ctx.scene.find('aviso'); if (a) { a.Sprite.rotulo = 'Você venceu! (toque para recomeçar)'; a.Sprite.invisivel = false; } }\n  }\n};\n"
      },
      "anciao": {
        "fonte": "// Mini-RPG (gerado a mão; os scripts são JS comum).\nconst eventos = {\n  gatilho(e, d, ctx) {\n    const o = ctx.scene.get(d.outro); if (!o || o.nome !== 'jogador') return;\n    const a = ctx.scene.find('aviso'); if (!a || ctx.vars.ler('fim') !== 'jogando') return;\n    a.Sprite.rotulo = 'Ancião: pegue as 3 moedas e fuja do slime!'; a.Sprite.invisivel = false;\n    ctx.depois(3, () => { if (ctx.vars.ler('fim') === 'jogando') a.Sprite.invisivel = true; });\n  }\n};\n"
      },
      "slime": {
        "fonte": "// Mini-RPG (gerado a mão; os scripts são JS comum).\nfunction atualizar(e, dt, ctx) {\n  const j = ctx.scene.find('jogador'); if (!j || ctx.vars.ler('fim') !== 'jogando') { ctx.caminho.parar(e); return; }\n  const st = e.Script.estado; st.t = (st.t || 0) + dt;\n  if (st.t >= 0.4) { st.t = 0; ctx.caminho.ir(ctx.scene, e, j.Transform.x, j.Transform.y, 90, { raio: 14 }); }\n}\nconst eventos = {\n  gatilho(e, d, ctx) {\n    const o = ctx.scene.get(d.outro); if (!o || o.nome !== 'jogador' || ctx.vars.ler('fim') !== 'jogando') return;\n    const st = e.Script.estado; if (st.cd > ctx.engine.tempo) return; st.cd = ctx.engine.tempo + 1;\n    ctx.vars.somar('vida', -1); ctx.efeitos.tremer(ctx.scene, 10, 0.3); ctx.efeitos.particulas(ctx.scene, o.Transform.x, o.Transform.y, { n: 10, cor: '#ff4444' });\n    if (ctx.vars.ler('vida') <= 0) { ctx.vars.definir('fim', 'perdeu'); ctx.efeitos.fade(ctx.scene, '#400000', 0, 0.8, 1); const a = ctx.scene.find('aviso'); if (a) { a.Sprite.rotulo = 'Você perdeu! (toque para recomeçar)'; a.Sprite.invisivel = false; } }\n  }\n};\n"
      }
    }
