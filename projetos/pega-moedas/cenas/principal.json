        "fonte": "// Gerado pelos blocos. Edite os blocos: este texto é refeito a cada mudança.\nfunction atualizar(e, dt, ctx) {\n  {\n    const st = e.Script.estado, iv = 1;\n    st[\"t0\"] = (st[\"t0\"] || 0) + dt;\n    if (iv > 0 && st[\"t0\"] >= iv) {\n      st[\"t0\"] = 0;\n      {\n        const t = 10;\n        ctx.scene.create({\n        nome: \"moeda\",\n        Transform: { x: ctx.engine.aleatorio(50, 750), y: ctx.engine.aleatorio(50, 400) },\n        Body: { forma: \"circulo\", raio: t, massa: 0, sensor: true },\n        Script: { nome: \"moeda\" },\n        Sprite: { forma: \"circulo\", raio: t, cor: \"#ffd23f\" }\n        });\n      }\n    }\n  }\n  {\n    const st = e.Script.estado, iv = 3;\n    st[\"t1\"] = (st[\"t1\"] || 0) + dt;\n    if (iv > 0 && st[\"t1\"] >= iv) {\n      st[\"t1\"] = 0;\n      {\n        const t = 14;\n        ctx.scene.create({\n        nome: \"bomba\",\n        Transform: { x: ctx.engine.aleatorio(50, 750), y: ctx.engine.aleatorio(50, 400) },\n        Body: { forma: \"circulo\", raio: t, massa: 0, sensor: true },\n        Script: { nome: \"bomba\" },\n        Sprite: { forma: \"circulo\", raio: t, cor: \"#ff4d4d\" }\n        });\n      }\n    }\n  }\n}\n"
