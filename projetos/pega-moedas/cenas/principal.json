        "fonte": "// Gerado pelos blocos. Edite os blocos: este texto é refeito a cada mudança.\nconst eventos = {\n  gatilho(e, d, ctx) {\n    const dt = ctx.dt;\n    if (((typeof d !== 'undefined' && d && ctx.scene.get(d.outro) ? ctx.scene.get(d.outro).nome : '') === \"jogador\")) {\n      ctx.vars.somar(\"pontos\", 1);\n      if (ctx.audio) ctx.audio.efeito(\"moeda\");\n      ctx.scene.destroy(e.id);\n    }\n  }\n};\n"
